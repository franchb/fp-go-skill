{
  // Allow long lines in skill reference docs (code examples, tables)
  "MD013": false,
  // Allow inline HTML (used in some markdown patterns)
  "MD033": false,
  // Allow multiple top-level headings (skill files have structured sections)
  "MD025": false,
  // Allow duplicate headings (common in reference docs)
  "MD024": false,
  // Allow compact table style (intentional for dense reference tables)
  "MD060": false,
  // Require consistent heading style
  "MD003": { "style": "atx" },
  // Require consistent list marker
  "MD004": { "style": "dash" },
  // Require blank lines around headings
  "MD022": true,
  // Require blank lines around fenced code blocks
  "MD031": true,
  // Require fenced code blocks to have a language specified
  "MD040": true
}
